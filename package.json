{
  "name": "fakalab",
  "private": true,
  "version": "0.1.0-beta.1",
  "type": "module",
  "license": "AGPL-3.0-only",
  "scripts": {
    "sync-assets": "node scripts/sync-assets.mjs",
    "predev": "npm run sync-assets",
    "prebuild": "npm run sync-assets",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "regions": "esbuild scripts/build-regions.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/regions.mjs --log-level=warning && node node_modules/.tmp/regions.mjs",
    "verify:recolor": "esbuild scripts/verify-recolor.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/verify-recolor.mjs --log-level=warning && node node_modules/.tmp/verify-recolor.mjs",
    "verify:export": "esbuild scripts/verify-export.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/verify-export.mjs --log-level=warning && node node_modules/.tmp/verify-export.mjs",
    "verify": "npm run verify:recolor && npm run verify:export",
    "backdrops": "esbuild scripts/build-backdrops.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/backdrops.mjs --log-level=warning && node node_modules/.tmp/backdrops.mjs",
    "knife-art": "esbuild scripts/build-knife-art.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/knife-art.mjs --log-level=warning && node node_modules/.tmp/knife-art.mjs",
    "favicon": "esbuild scripts/build-favicon.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/favicon.mjs --log-level=warning && node node_modules/.tmp/favicon.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "fflate": "^0.8.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
